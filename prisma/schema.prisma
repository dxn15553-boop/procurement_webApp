// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  TEAM
  MANAGER
}

enum CSStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PRStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
}

enum POStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum CurrentStage {
  CS
  PR
  PO
  MDD
  MRD
  WCD
  PRL
  PAR
  PDD
  COMPLETED
  CANCELLED
}

enum SLAStatus {
  ON_TRACK
  AT_RISK
  OVERDUE
  COMPLETED
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  passwordHash    String
  tempPassword    String?  // Plain-text password visible only to Manager; cleared when user self-changes
  role            Role     @default(TEAM)
  departmentId    String?
  isActive        Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  department          Department?           @relation(fields: [departmentId], references: [id])
  procurementRequests ProcurementRequest[]
  handledRequests     ProcurementRequest[]  @relation("RequestHandler")
  activityLogs        ActivityLog[]
  notifications       Notification[]
  sessions            Session[]
  rfqsCreated         Rfq[]
  csApproved          ComparativeStatement[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Department {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  head      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  procurementRequests ProcurementRequest[]
}

model Vendor {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  procurementRequests ProcurementRequest[]
}

model ProcurementRequest {
  id          String   @id @default(cuid())

  // Source Info
  sourceNo          String   @unique
  sourceDate        DateTime
  sourceDescription String

  // Department & Vendor
  departmentId String
  vendorId     String?

  // Comparative Statement
  comparativeDate  DateTime?
  daysForCS        Int?
  csStatus         CSStatus  @default(PENDING)

  // Purchase Requisition
  prNumber  String?
  prDate    DateTime?
  daysForPR Int?
  prStatus  PRStatus  @default(PENDING)

  // Purchase Order
  poNumber String?
  poDate   DateTime?
  poStatus POStatus  @default(PENDING)
  daysForPO Int?

  // PRL
  prlNo   String?
  prlDate DateTime?

  // Dates
  materialDispatchDate  DateTime?
  materialReceivedDate  DateTime?
  workCompletionDate    DateTime?
  sourceCancellationDate DateTime?
  paymentApprovalDate    DateTime?
  paymentDoneDate        DateTime?
  paymentStatus          PaymentStatus @default(PENDING)
  daysForPayment         Int?

  // Entry Management
  isDeleted              Boolean @default(false)

  // Handler Info
  currentStatusByHandler String?
  nameOfHandler          String?
  handlerId              String?
  noOfDays               Int?
  currentStage           CurrentStage @default(CS)
  pendingFrom            DateTime?
  pendingDays            Int?

  // SLA
  slaStatus   SLAStatus @default(ON_TRACK)
  slaCS       Int?
  slaPR       Int?
  slaPO       Int?
  slaMDD      Int?
  slaMRD      Int?
  slaWCD      Int?
  slaPRL      Int?
  slaPAR      Int?
  slaPDD      Int?

  // Procurement Received Date (when procurement first took ownership — different from sourceDate which is the requester's original submission date)
  procurementReceivedDate DateTime?

  // Meta
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  department   Department   @relation(fields: [departmentId], references: [id])
  vendor       Vendor?      @relation(fields: [vendorId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])
  handler      User?        @relation("RequestHandler", fields: [handlerId], references: [id])
  activityLogs ActivityLog[]
  notifications Notification[]
}

model ActivityLog {
  id        String   @id @default(cuid())
  requestId String?
  userId    String
  action    String
  fieldName String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  request ProcurementRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  user    User                @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  requestId String?
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User                @relation(fields: [userId], references: [id])
  request ProcurementRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
}

enum RfqStatus {
  DRAFT
  DISPATCHED
  IN_PROGRESS
  QUOTES_RECEIVED
  CLOSED
  CANCELLED
}

enum RfqVendorStatus {
  INVITED
  VIEWED
  SUBMITTED
  DECLINED
  EXPIRED
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

enum CSApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  RETURNED
  REJECTED
}

model Rfq {
  id                  String                @id @default(cuid())
  rfqNumber           String                @unique
  sourceNo            String
  title               String
  description         String
  specifications      String?
  quantity            Int?
  unit                String?
  requiredDate        DateTime?
  submissionDeadline  DateTime
  deliveryLocation    String?
  termsAndConditions  String?
  status              RfqStatus             @default(DRAFT)
  createdById         String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  createdBy           User                  @relation(fields: [createdById], references: [id])
  vendors             RfqVendor[]
  comparativeStatement ComparativeStatement?
}

model RfqVendor {
  id              String          @id @default(cuid())
  rfqId           String
  vendorId        String          // ID from Supabase Vendor master
  vendorName      String
  vendorEmail     String
  status          RfqVendorStatus @default(INVITED)
  sentAt          DateTime        @default(now())
  viewedAt        DateTime?
  respondedAt     DateTime?
  accessKey       String          @unique @default(cuid())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  rfq             Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quotations      Quotation[]
}

model Quotation {
  id              String          @id @default(cuid())
  quotationNo     String
  rfqVendorId     String
  vendorId        String          // Supabase vendor id
  version         Int             @default(1)
  baseAmount      Float
  taxAmount       Float           @default(0)
  freightCharges  Float           @default(0)
  otherCharges    Float           @default(0)
  totalAmount     Float
  leadTimeDays    Int?
  paymentTerms    String?
  deliveryTerms   String?
  validityDays    Int?
  documentUrl     String?
  remarks         String?
  status          QuotationStatus @default(SUBMITTED)
  submittedAt     DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  rfqVendor       RfqVendor       @relation(fields: [rfqVendorId], references: [id], onDelete: Cascade)
  items           QuotationItem[]
  csItems         ComparativeStatementItem[]
}

model QuotationItem {
  id              String    @id @default(cuid())
  quotationId     String
  description     String
  quantity        Float
  unit            String
  unitPrice       Float
  taxRate         Float     @default(0)
  totalPrice      Float
  createdAt       DateTime  @default(now())

  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model ComparativeStatement {
  id                    String                     @id @default(cuid())
  csNumber              String                     @unique
  rfqId                 String                     @unique
  sourceNo              String
  status                CSApprovalStatus           @default(DRAFT)
  recommendedVendorId   String?
  recommendedVendorName String?
  recommendationReason  String?
  approvalComments      String?
  approvedById          String?
  approvedAt            DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  rfq                   Rfq                        @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  approvedBy            User?                      @relation(fields: [approvedById], references: [id])
  items                 ComparativeStatementItem[]
}

model ComparativeStatementItem {
  id               String               @id @default(cuid())
  csId             String
  quotationId      String
  evaluatedAmount  Float
  isLowest         Boolean              @default(false)
  technicalStatus  String?
  commercialStatus String?
  remarks          String?
  createdAt        DateTime             @default(now())

  cs               ComparativeStatement @relation(fields: [csId], references: [id], onDelete: Cascade)
  quotation        Quotation            @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}
